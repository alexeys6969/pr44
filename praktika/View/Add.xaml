<Page x:Class="praktika.View.Add"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:praktika.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Add" Background="White"
      FontFamily="Monocraft">
    <Page.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="ForestGreen"/>
            <Setter Property="BorderBrush" Value="ForestGreen"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Page.Resources>
    <Grid>
        <StackPanel>
            <TextBlock Text="{Binding OnEditAddMainText}" FontSize="20" HorizontalAlignment="Center" Margin="0,15,0,0"/>
            <TextBlock Text="Введите ФИО" FontSize="15" Margin="20,30,0,0" HorizontalAlignment="Left"/>
            <TextBox Text="{Binding Name}" Margin="20,10,20,0" Height="30"/>

            <TextBlock Text="Выберите курс" FontSize="15" Margin="20,30,0,0" HorizontalAlignment="Left"/>
            <ComboBox Margin="20,10,20,0" Height="30"/>

            <TextBlock Text="Введите специальность" FontSize="15" Margin="20,30,0,0" HorizontalAlignment="Left"/>
            <TextBox Text="{Binding Speciality}" Margin="20,10,20,0" Height="30"/>

            <TextBlock Text="Введите возраст" FontSize="15" Margin="20,30,0,0" HorizontalAlignment="Left"/>
            <TextBox Text="{Binding Age}" Margin="20,10,20,0" Height="30"/>

            <Button Content="{Binding AddEditBthText}" HorizontalAlignment="Center" Padding="40,0" 
                    Height="30" Width="250" Margin="0,25,0,0" VerticalAlignment="Bottom" Command="{Binding OnEdit}"/>
        </StackPanel>
    </Grid>
</Page>
