<UserControl x:Class="praktika.View.Items.Item"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:praktika.View.Items"
             mc:Ignorable="d" Background="White" FontFamily="Monocraft">
    <UserControl.Resources>
        <Style TargetType="Button" x:Key="Update">
            <Setter Property="Background" Value="ForestGreen"/>
            <Setter Property="BorderBrush" Value="ForestGreen"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="Button" x:Key="Delete">
            <Setter Property="Background" Value="DarkRed"/>
            <Setter Property="BorderBrush" Value="DarkRed"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </UserControl.Resources>
    <Border CornerRadius="45">
        <Grid Margin="10,15,10,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <Image Source="/Images/ic_student.png" Width="25"
                   VerticalAlignment="Top" HorizontalAlignment="Left"/>

                <Button Style="{StaticResource Update}" Height="15" Content="Обновить" Padding="10,0"
                        Margin="0,10,10,0" Command="{Binding OnUpdate}"/>

                <Button Style="{StaticResource Delete}" Height="15" Content="Удалить" Padding="10,0"
                        Margin="0,10,10,0" Command="{Binding OnDelete}"/>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Text="ФИО: " VerticalAlignment="Top" HorizontalAlignment="Left"
                           Margin="15,0,0,0"/>
                <TextBlock Text="{Binding Name}" FontWeight="ExtraLight" Foreground="LightGray" VerticalAlignment="Top" HorizontalAlignment="Left"
                           Margin="15,0,0,0"/>

                <TextBlock Text="Курс: " VerticalAlignment="Top" HorizontalAlignment="Left"
                           Margin="15,20,0,0"/>
                <TextBlock Text="{Binding Course}" FontWeight="ExtraLight" Foreground="LightGray" VerticalAlignment="Top" HorizontalAlignment="Left"
                           Margin="15,0,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Специальность: " VerticalAlignment="Top" HorizontalAlignment="Left"
                           Margin="15,0,0,0"/>
                <TextBlock Text="{Binding Speciality}" FontWeight="ExtraLight" Foreground="LightGray" VerticalAlignment="Top" HorizontalAlignment="Left"
                           Margin="15,0,0,0"/>

                <TextBlock Text="Возраст: " VerticalAlignment="Top" HorizontalAlignment="Left"
                           Margin="15,20,0,0"/>
                <TextBlock Text="{Binding Age}" FontWeight="ExtraLight" Foreground="LightGray" VerticalAlignment="Top" HorizontalAlignment="Left"
                           Margin="15,0,0,0"/>
            </StackPanel>
        </Grid>
    </Border>

</UserControl>

        
        
        
