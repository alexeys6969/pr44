<Page x:Class="praktika.View.Main"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:praktika.View"
      xmlns:element="clr-namespace:praktika.View.Items"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Main"
      FontFamily="Monocraft">
    <Page.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="ForestGreen"/>
            <Setter Property="BorderBrush" Value="ForestGreen"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Page.Resources>
    <Grid>
        <ListView ItemsSource="{Binding Items}" HorizontalContentAlignment="Stretch" Margin="0,0,0,40">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <!--<element:Item DataContext="{Binding}"-->
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Button Height="25" Width="100" Content="Добавить"  VerticalAlignment="Bottom"
                       HorizontalAlignment="Right" Margin="0,0,10,10" Command="{Binding OnUpdate}"/>
    </Grid>
</Page>
